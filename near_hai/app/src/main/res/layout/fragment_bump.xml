<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- 碰一碰按钮 -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnBump"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="48dp"
            android:contentDescription="@string/btn_bump"
            android:src="@android:drawable/ic_menu_compass"
            app:backgroundTint="@color/bump_button"
            app:fabSize="normal"
            app:maxImageSize="64dp"
            app:tint="@android:color/white"
            app:rippleColor="@color/bump_button_pressed" />

        <!-- 状态提示 -->
        <TextView
            android:id="@+id/tvBumpStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/bump_hint"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:textAlignment="center" />

        <!-- 扫描进度 -->
        <ProgressBar
            android:id="@+id/progressScan"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="200dp"
            android:layout_height="4dp"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:indeterminate="false"
            android:max="100" />

        <!-- 发现设备列表 -->
        <TextView
            android:id="@+id/tvScanTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="发现的设备"
            android:textColor="@color/on_surface"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/containerDiscovered"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <!-- 最近添加的好友 -->
        <TextView
            android:id="@+id/tvRecentTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="最近添加的好友"
            android:textColor="@color/on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRecentFriend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="暂无"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
